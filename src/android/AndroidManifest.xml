<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.appliedastrology.tuvi"
    android:versionCode="@VERSION_CODE@"
    android:versionName="0.0.3"
    android:installLocation="auto">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- v0.0.3: tự cập nhật (tải APK từ GitHub Releases rồi mở trình cài đặt hệ thống) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <supports-screens android:smallScreens="true" android:normalScreens="true" android:largeScreens="true" android:xlargeScreens="true" android:anyDensity="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:extractNativeLibs="true"
        android:theme="@style/AppTheme">

        <!-- Samsung DeX: cho phép đổi kích thước cửa sổ, khởi chạy ở chế độ cửa sổ lớn -->
        <meta-data android:name="com.samsung.android.keepalive.density" android:value="true" />
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <layout android:defaultWidth="1280dp" android:defaultHeight="820dp" android:minWidth="360dp" android:minHeight="480dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name=".ApkProvider"
            android:authorities="com.appliedastrology.tuvi.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
